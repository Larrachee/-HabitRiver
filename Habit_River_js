const exportBtn = document.getElementById('export-data');
const importBtn = document.getElementById('import-data');
const importFile = document.getElementById('import-file');

// --- THEME ---
const savedTheme = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', savedTheme);
updateThemeButton(savedTheme);

themeToggle.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
    updateThemeButton(newTheme);
});

function updateThemeButton(theme) {
    const icon = theme === 'light' ? 'fa-sun' : 'fa-moon';
    const text = theme === 'light' ? 'Light' : 'Dark';
    themeToggle.innerHTML = `<i class="fas ${icon}"></i> ${text}`;
}

// --- SOUND ---
updateSoundButton();
soundToggle.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    localStorage.setItem('soundEnabled', JSON.stringify(soundEnabled));
    updateSoundButton();
    if (soundEnabled) playSound('complete');
});

function updateSoundButton() {
    const icon = soundEnabled ? 'fa-volume-high' : 'fa-volume-xmark';
    const text = soundEnabled ? 'Sound' : 'Muted';
    soundToggle.innerHTML = `<i class="fas ${icon}"></i> ${text}`;
    soundToggle.classList.toggle('muted', !soundEnabled);
}

function playSound(type) {
    if (!soundEnabled) return;
    try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const now = audioCtx.currentTime;

        const makeBeep = (freq, start, dur, vol = 0.08, wave = 'sine') => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = wave;
            osc.frequency.value = freq;
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            gain.gain.setValueAtTime(vol, now + start);
            gain.gain.exponentialRampToValueAtTime(0.001, now + start + dur);
            osc.start(now + start);
            osc.stop(now + start + dur);
        };

        if (type === 'complete') {
            makeBeep(800, 0, 0.15, 0.06, 'sine');
            makeBeep(1200, 0.05, 0.15, 0.05, 'sine');
        } else if (type === 'undo') {
            makeBeep(400, 0, 0.15, 0.05, 'triangle');
        } else if (type === 'levelup') {
            [523.25, 659.25, 783.99, 1046.5].forEach((f, i) =>
                makeBeep(f, i * 0.1, 0.3, 0.07, 'sine'));
        } else if (type === 'achievement') {
            [659.25, 880].forEach((f, i) =>
                makeBeep(f, i * 0.12, 0.35, 0.07, 'sine'));
        }
    } catch (e) {
        console.warn('Sound error:', e);
    }
}

// --- CONFETTI ---
function fireConfetti() {
    if (typeof confetti !== 'function') return;
    confetti({
        particleCount: 80,
        spread: 70,
        origin: { y: 0.7 },
        colors: ['#38bdf8', '#818cf8', '#10b981', '#f97316']
    });
}

function fireLevelUpConfetti() {
    if (typeof confetti !== 'function') return;
    const duration = 2000;
    const end = Date.now() + duration;
    (function frame() {
        confetti({ particleCount: 4, angle: 60, spread: 55, origin: { x: 0 }, colors: ['#38bdf8', '#818cf8'] });
        confetti({ particleCount: 4, angle: 120, spread: 55, origin: { x: 1 }, colors: ['#f97316', '#10b981'] });
        if (Date.now() < end) requestAnimationFrame(frame);
    })();
}

// --- RESET DATA ---
resetDataBtn.addEventListener('click', () => {
    if (confirm('Are you sure you want to reset all data? This cannot be undone!')) {
        localStorage.clear();
        habits = [];
        userProfile = { xp: 0, level: 1 };
        unlockedAchievements = [];
        localStorage.setItem('userProfile', JSON.stringify(userProfile));
        showToast('All data has been reset', 'error');
        saveAndRender();
    }
});

// --- EXPORT / IMPORT ---
exportBtn.addEventListener('click', () => {
    const data = {
        habits,
        userProfile,
        unlockedAchievements,
        exportedAt: new Date().toISOString()
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `habitriver-backup-${getTodayStr()}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('📤 Data exported successfully!', 'success');
});

importBtn.addEventListener('click', () => importFile.click());

importFile.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
        try {
            const data = JSON.parse(ev.target.result);
            if (!data.habits || !Array.isArray(data.habits)) throw new Error('Invalid format');
            habits = data.habits;
            userProfile = data.userProfile || { xp: 0, level: 1 };
            unlockedAchievements = data.unlockedAchievements || [];
            localStorage.setItem('habits', JSON.stringify(habits));
            localStorage.setItem('userProfile', JSON.stringify(userProfile));
            localStorage.setItem('achievements', JSON.stringify(unlockedAchievements));
            saveAndRender();
            showToast('📥 Data imported successfully!', 'success');
        } catch (err) {
            showToast('❌ Failed to import file', 'error');
        }
    };
    reader.readAsText(file);
    importFile.value = '';
});

// --- TOAST SYSTEM ---
function showToast(message, type = 'success', duration = 3000) {
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    const icons = {
        success: 'fa-check-circle',
        error: 'fa-exclamation-circle',
        'level-up': 'fa-star',
        achievement: 'fa-medal'
    };
    toast.innerHTML = `
        <i class="fas ${icons[type] || icons.success}" style="color: var(--primary-color);"></i>
        <span>${message}</span>
        <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
    `;
    toastContainer.appendChild(toast);
    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => toast.remove(), 300);
    }, duration);
}

// --- DATE UTILS ---
function getPastSevenDays() {
    const days = [];
    for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const dateStr = d.toISOString().split('T')[0];
        const label = d.toLocaleDateString('en-US', { weekday: 'short' });
        days.push({ dateStr, label });
    }
    return days;
}

function getTodayStr() {
    return new Date().toISOString().split('T')[0];
}

// --- STREAK CALCULATION ---
function calculateStreak(history) {
    let streak = 0;
    let checkDate = new Date();
    let todayStr = getTodayStr();

    if (!history[todayStr]) {
        checkDate.setDate(checkDate.getDate() - 1);
    }

    while (true) {
        let dateStr = checkDate.toISOString().split('T')[0];
        if (history[dateStr]) {
            streak++;
            checkDate.setDate(checkDate.getDate() - 1);
        } else {
            break;
        }
    }
    return streak;
}

function getBestStreak(history) {
    let dates = Object.keys(history).sort();
    if (dates.length === 0) return 0;

    let bestStreak = 1;
    let currentStreak = 1;

    for (let i = 1; i < dates.length; i++) {
        const prev = new Date(dates[i - 1]);
        const curr = new Date(dates[i]);
        const diffDays = (curr - prev) / (1000 * 60 * 60 * 24);

        if (diffDays === 1) {
            currentStreak++;
            bestStreak = Math.max(bestStreak, currentStreak);
        } else if (diffDays > 1) {
            currentStreak = 1;
        }
    }
    return bestStreak;
}

// --- XP SYSTEM ---
function getTotalXp() {
    let total = userProfile.xp;
    for (let i = 1; i < userProfile.level; i++) total += i * 100;
    return total;
}

function addXP(amount) {
    userProfile.xp += amount;
    let nextLevelXp = userProfile.level * 100;
    let leveledUp = false;

    if (userProfile.xp >= nextLevelXp) {
        userProfile.xp -= nextLevelXp;
        userProfile.level += 1;
        leveledUp = true;
        showToast(`🎉 LEVEL UP! You reached Level ${userProfile.level}!`, 'level-up', 4000);
    } else if (userProfile.xp < 0) {
        if (userProfile.level > 1) {
            userProfile.level -= 1;
            userProfile.xp = (userProfile.level * 100) + userProfile.xp;
        } else {
            userProfile.xp = 0;
        }
    }

    localStorage.setItem('userProfile', JSON.stringify(userProfile));

    if (leveledUp) {
        playSound('levelup');
        fireLevelUpConfetti();
    }

    updateProfileUI();
    renderLeaderboard();
    updateStats();
    checkAchievements();
}

// --- UPDATE UI ---
function updateProfileUI() {
    const nextLevelXp = userProfile.level * 100;
    const pct = Math.min((userProfile.xp / nextLevelXp) * 100, 100);
    const levelNames = ['Novice', 'Explorer', 'Champion', 'Master', 'Legend', 'Mythic'];
    const levelName = levelNames[Math.min(userProfile.level - 1, levelNames.length - 1)] || 'Mythic';

    document.getElementById('user-level').textContent = `Level ${userProfile.level} (${levelName})`;
    document.getElementById('xp-bar').style.width = `${pct}%`;
    document.getElementById('xp-text').textContent = `${Math.floor(userProfile.xp)} / ${nextLevelXp} XP`;
    document.getElementById('total-xp').textContent = getTotalXp();
}

function updateStats() {
    const today = getTodayStr();
    const total = habits.length;
    const completedToday = habits.filter(h => h.history[today]).length;
    const bestStreak = habits.reduce((max, h) => Math.max(max, getBestStreak(h.history)), 0);

    document.getElementById('total-habits').textContent = total;
    document.getElementById('completed-today').textContent = completedToday;
    document.getElementById('streak-count').textContent = bestStreak;
}

// --- ACHIEVEMENTS ---
function checkAchievements() {
    let newUnlocks = [];
    ACHIEVEMENTS.forEach(ach => {
        if (!unlockedAchievements.includes(ach.id) && ach.check()) {
            unlockedAchievements.push(ach.id);
            newUnlocks.push(ach);
        }
    });

    if (newUnlocks.length > 0) {
        localStorage.setItem('achievements', JSON.stringify(unlockedAchievements));
        newUnlocks.forEach(ach => {
            showToast(`🏅 Achievement unlocked: ${ach.name}!`, 'achievement', 4000);
        });
        playSound('achievement');
        renderAchievements();
    }
}

function renderAchievements() {
    const container = document.getElementById('achievements-list');
    container.innerHTML = '';

    ACHIEVEMENTS.forEach(ach => {
        const unlocked = unlockedAchievements.includes(ach.id);
        const card = document.createElement('div');
        card.className = `achievement-card ${unlocked ? 'unlocked' : ''}`;
        card.title = `${ach.name} — ${ach.desc}`;
        card.innerHTML = `
            <span class="ach-icon">${ach.icon}</span>
            <span class="ach-name">${ach.name}</span>
        `;
        container.appendChild(card);
    });
}

// --- LEADERBOARD ---
function renderLeaderboard() {
    const leaderboardList = document.getElementById('leaderboard-list');
    leaderboardList.innerHTML = '';

    const totalUserXp = getTotalXp();

    let boardData = [
        { name: "👑 You", totalXp: totalUserXp, level: userProfile.level, isUser: true },
        ...competitors.map(c => ({
            name: c.name,
            totalXp: c.baseXp + (c.level - 1) * 100,
            level: c.level,
            isUser: false
        }))
    ];
    boardData.sort((a, b) => b.totalXp - a.totalXp);

    boardData.forEach((player, index) => {
        const row = document.createElement('div');
        row.classList.add('leaderboard-item');
        if (player.isUser) row.classList.add('user-row');

        let rankClass = '';
        if (index === 0) rankClass = 'gold';
        else if (index === 1) rankClass = 'silver';
        else if (index === 2) rankClass = 'bronze';

        row.innerHTML = `
            <span class="rank ${rankClass}">#${index + 1}</span>
            <span class="player-name">${player.name}</span>
            <span class="player-score">Lv.${player.level} (${player.totalXp} XP)</span>
        `;
        leaderboardList.appendChild(row);
    });
}

// --- CHART ---
function updateChart() {
    const pastDays = getPastSevenDays();
    const labels = pastDays.map(d => d.label);
    const dataValues = pastDays.map(day =>
        habits.filter(h => h.history[day.dateStr]).length
    );

    if (progressChart) progressChart.destroy();

    const ctx = document.getElementById('progressChart').getContext('2d');
    const gradient = ctx.createLinearGradient(0, 0, 0, 250);
    gradient.addColorStop(0, 'rgba(56, 189, 248, 0.2)');
    gradient.addColorStop(1, 'rgba(56, 189, 248, 0)');

    progressChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Habits Completed',
                data: dataValues,
                borderColor: '#38bdf8',
                backgroundColor: gradient,
                borderWidth: 3,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#38bdf8',
                pointBorderColor: 'var(--bg-color)',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1, color: 'var(--text-muted)' },
                    grid: { color: 'var(--border-color)' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: 'var(--text-muted)' }
                }
            },
            interaction: { intersect: false, mode: 'index' }
        }
    });
}

// --- FILTER ---
function filterHabits(category) {
    currentFilter = category;
    document.querySelectorAll('.btn-filter').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === category);
    });
    renderHabits();
}

document.querySelectorAll('.btn-filter').forEach(btn => {
    btn.addEventListener('click', () => filterHabits(btn.dataset.filter));
});

// --- CRUD ---
habitForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = habitNameInput.value.trim();
    const category = habitCategoryInput.value;
    if (!name) return;

    habits.push({
        id: Date.now().toString(),
        name,
        category,
        history: {}
    });

    saveAndRender();
    habitNameInput.value = '';
    showToast(`✅ Habit "${name}" added!`, 'success');
    playSound('complete');
});

// Toggle habit completion (works for any date — backfill allowed)
window.toggleHabit = function (id, dateStr) {
    const today = getTodayStr();
    const isPast = dateStr !== today;

    habits = habits.map(habit => {
        if (habit.id === id) {
            if (habit.history[dateStr]) {
                delete habit.history[dateStr];
                addXP(-15);
                playSound('undo');
                showToast(`↩️ ${isPast ? 'Backfill removed' : 'Habit undone'} (-15 XP)`, 'error');
            } else {
                habit.history[dateStr] = true;
                addXP(15);
                playSound('complete');
                if (!isPast) fireConfetti();
                showToast(`✅ Habit completed${isPast ? ' (backfill)' : ''}! (+15 XP)`, 'success');
            }
        }
        return habit;
    });
    saveAndRender();
};

window.deleteHabit = function (id) {
    if (confirm('Delete this habit?')) {
        const habit = habits.find(h => h.id === id);
        habits = habits.filter(h => h.id !== id);
        saveAndRender();
        if (habit) showToast(`🗑️ "${habit.name}" deleted`, 'error');
    }
};

function saveAndRender() {
    localStorage.setItem('habits', JSON.stringify(habits));
    renderHabits();
    updateChart();
    renderLeaderboard();
    updateStats();
    updateProfileUI();
    checkAchievements();
}

// --- RENDER HABITS ---
function renderHabits() {
    habitList.innerHTML = '';
    const pastDays = getPastSevenDays();
    const todayStr = getTodayStr();

    const filteredHabits = habits.filter(habit => {
        if (currentFilter === 'All') return true;
        return habit.category === currentFilter;
    });

    if (filteredHabits.length === 0) {
        habitList.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>No habits found in this category.</p>
                <p style="font-size: 0.85rem; margin-top: 4px;">Start building your habits today!</p>
            </div>
        `;
        return;
    }

    filteredHabits.forEach(habit => {
        const habitCard = document.createElement('div');
        habitCard.classList.add('habit-card');

        const isDoneToday = !!habit.history[todayStr];
        const streak = calculateStreak(habit.history);

        habitCard.innerHTML = `
            <div class="habit-header">
                <div class="habit-title-area">
                    <h3>${habit.name}</h3>
                    <span class="category-tag">${habit.category || '📦 General'}</span>
                    <span class="streak-badge">🔥 ${streak} Days</span>
                </div>
                <div class="habit-actions">
                    <button class="btn-done ${isDoneToday ? 'undo' : ''}" onclick="toggleHabit('${habit.id}', '${todayStr}')">
                        <i class="fas ${isDoneToday ? 'fa-undo' : 'fa-check'}"></i>
                        ${isDoneToday ? 'Undo' : 'Done (+15 XP)'}
                    </button>
                    <button class="btn-delete" onclick="deleteHabit('${habit.id}')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
            <div class="grid-container" id="grid-${habit.id}"></div>
        `;

        habitList.appendChild(habitCard);

        const gridContainer = document.getElementById(`grid-${habit.id}`);
        pastDays.forEach(day => {
            const dayWrapper = document.createElement('div');
            dayWrapper.classList.add('grid-day');

            const cube = document.createElement('div');
            cube.classList.add('cube');
            if (habit.history[day.dateStr]) cube.classList.add('completed');
            if (day.dateStr === todayStr) cube.classList.add('today');
            cube.title = `Click to toggle ${day.dateStr}`;
            cube.onclick = () => window.toggleHabit(habit.id, day.dateStr);

            const label = document.createElement('span');
            label.textContent = day.label;

            dayWrapper.appendChild(cube);
            dayWrapper.appendChild(label);
            gridContainer.appendChild(dayWrapper);
        });
    });
}

// --- INIT ---
function init() {
    updateProfileUI();
    renderHabits();
    updateChart();
    renderLeaderboard();
    updateStats();
    renderAchievements();
    checkAchievements();
}

init();
